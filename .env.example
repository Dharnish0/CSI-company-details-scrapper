# Copy to .env and adjust. Never commit .env. Defaults follow ARCHITECTURE.md section 12.

# Root target. Retargeting = changing these three values.
START_URL=https://www.csisoftware.com/
ROOT_COMPANY=Constellation Software Inc.
ROOT_CODE=CSI

# Crawl limits and politeness
MAX_DEPTH=8
MAX_PAGES_PER_DOMAIN=40
MAX_TOTAL_PAGES=2000
REQUEST_TIMEOUT=20
REQUEST_DELAY_SECONDS=2.0
MAX_RETRIES=2
USER_AGENT=CorpDiscoveryBot/0.1 (+contact-url-or-email)
RESPECT_ROBOTS=true
ALLOW_INSECURE_SSL=false
# auto | true | false
USE_PLAYWRIGHT=auto

# Confidence thresholds (0 to 1). REVIEW <= LOW_CONFIDENCE <= CONFIRM.
CONFIRM_THRESHOLD=0.75
REVIEW_THRESHOLD=0.40
LOW_CONFIDENCE_THRESHOLD=0.60
FUZZY_MATCH_THRESHOLD=0.92
RECURSE_INTO_REVIEW=false
MAX_LINKS_PER_ENTITY=12

# M1 fetching, caching and rendering
MAX_RESPONSE_BYTES=2000000
FETCH_MAX_REDIRECTS=5
# Seconds a cached page stays fresh (0 = never reuse the cache)
PAGE_CACHE_TTL_SECONDS=604800
PLAYWRIGHT_TIMEOUT_SECONDS=30
PLAYWRIGHT_MIN_TEXT_CHARS=200
ROBOTS_FAILURE_COOLDOWN_SECONDS=600
# Refuse loopback/private hosts (SSRF guard). Leave false outside tests.
ALLOW_PRIVATE_HOSTS=false
# Comma list; a trailing * means prefix
TRACKING_QUERY_PARAMS=utm_*,fbclid,gclid,dclid,msclkid,mc_cid,mc_eid,yclid,igshid,_hsenc,_hsmi
# M1 matching, commit and budgets
# Comma list of multi-tenant platforms that never count as a dedicated company domain
SHARED_PLATFORM_DOMAINS=linkedin.com,facebook.com,twitter.com,x.com,instagram.com,youtube.com,github.com,medium.com,wikipedia.org,crunchbase.com,wordpress.com,blogspot.com,wixsite.com,squarespace.com,github.io,sites.google.com
REQUIRE_WEBSITE_FOR_CONFIRMED=true
# Blank = unlimited
LLM_TOKEN_BUDGET=
MAX_LLM_CALLS_PER_TASK=12
MAX_LLM_CALLS_PER_RUN=5000
MAX_TOOL_CALLS_PER_TASK=20
MAX_TOOL_CALLS_PER_RUN=5000
# M2 agent infrastructure: request cap per invocation (transport + repair + tool loop),
# circuit breaker, LLM transport retries/backoff, temperature, record/replay cassettes
MAX_PROVIDER_REQUESTS_PER_INVOCATION=6
LLM_BREAKER_THRESHOLD=5
LLM_TRANSPORT_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=30.0
# Rate limiting (HTTP 429). -1 = provider default (groq: 30 requests/minute; no client-side token cap), 0 = disabled.
# Server x-ratelimit-* headers and Retry-After always take precedence. Check your Groq plan limits in the console.
LLM_RPM_LIMIT=-1
LLM_TPM_LIMIT=-1
# Groq free-tier base limits: 8K tokens per minute (TPM), 30 requests per minute (RPM), 1K requests per DAY (RPD) and
# 200K tokens per day (TPD). Never set LLM_TPM_LIMIT above the real TPM of your plan; for long runs use --slow-crawl below.
LLM_RATE_LIMIT_RETRIES=5
# Retry-After longer than this (seconds) is not slept in-process: the task is rescheduled instead.
LLM_RETRY_AFTER_CEILING_SECONDS=120
LLM_TEMPERATURE=0.0
# Queue recovery for transient LLM failures (429/timeout/5xx): attempts per task, backoff base, longest in-process wait
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BASE_SECONDS=60
QUEUE_RETRY_WAIT_MAX_SECONDS=300
# HTTP 429 waits per task that do not use up a queue attempt (per process; 0 = every wait uses an attempt)
QUEUE_MAX_RATE_LIMIT_DEFERRALS=6
LLM_CASSETTE_DIR=./.cache/llm_cassettes

# Slow crawl mode (python main.py run|resume --slow-crawl): one provider request at a time across all agents, a minimum
# gap between request starts, adaptive pacing, automatic cooldown after HTTP 429 and a runtime cap. When on, it replaces
# LLM_RPM_LIMIT / LLM_TPM_LIMIT. Off by default.
SLOW_CRAWL=false
SLOW_CRAWL_INTERVAL_SECONDS=90
SLOW_CRAWL_MAX_RUNTIME_HOURS=24
# Tokens one slow-crawl session may spend (counted from the session start); the session stops gracefully at the ceiling
SLOW_CRAWL_TOKEN_CEILING=250000
# Blank = no cost ceiling. Needs LLM_PRICE_IN_PER_MTOK / LLM_PRICE_OUT_PER_MTOK to be set to have any effect
SLOW_CRAWL_COST_CEILING_USD=
# Tokens per minute assumed when the provider sends no x-ratelimit-limit-tokens header, and the share of it to aim for
SLOW_CRAWL_TPM_LIMIT=8000
SLOW_CRAWL_TPM_TARGET_FRACTION=0.70
# Tokens per day used for proactive waiting (0 = off); a daily-quota 429 without Retry-After waits this many seconds
SLOW_CRAWL_TPD_LIMIT=200000
SLOW_CRAWL_DAILY_RETRY_SECONDS=900
# Longest uninterrupted sleep (shutdown latency) and progress report cadence, in seconds
SLOW_CRAWL_SLEEP_CHUNK_SECONDS=30
SLOW_CRAWL_PROGRESS_INTERVAL_SECONDS=300

# M7 supporting agents: advisor on/off and minimum confidence, dedup merge/different confidence,
# validation demotion confidence, website selection confidence
ADVISOR_ENABLED=true
ADVISOR_MIN_CONF=0.60
DEDUP_MERGE_CONF=0.85
DEDUP_DIFFERENT_CONF=0.70
VALIDATION_MIN_CONF=0.50
WEBSITE_MIN_CONF=0.70

# M8 real providers: request timeout, optional base URL (blank = provider default), prices in USD per million
# tokens (cost accounting only), and an optional JSONL cassette that records every successful response
LLM_TIMEOUT_SECONDS=60
LLM_BASE_URL=
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
LLM_RECORD_TO=
# Ollama: context window sent with every request (constant; must hold prompt + reasoning + output) and keep-alive
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=12288
OLLAMA_KEEP_ALIVE=30m
# Extraction Agent reasoning: none (thinking off, recommended for structured extraction) or default (model default)
LLM_EXTRACTION_REASONING=none
# LLM provider: "openai", "anthropic", "ollama" (local, native /api/chat), "gemini", "fake", "replay", or blank
# For ollama: LLM_BASE_URL defaults to http://localhost:11434, LLM_API_KEY is not used
# For gemini: GEMINI_API_KEY is required (from https://aistudio.google.com/app/apikey)
LLM_PROVIDER=
# LLM model name (required for real providers; blank or "unspecified" for fake/replay)
LLM_MODEL=
# LLM_API_KEY required for openai/anthropic; blank for ollama (local usage)
LLM_API_KEY=
# Gemini-specific settings (separate from Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# off | low | default. "off" keeps structured JSON from being truncated by hidden thinking tokens.
GEMINI_THINKING=off
# Groq-specific settings
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Runtime provider/model selection (CLI override, not stored in .env)
# RUN_PROVIDER=gemini|groq|ollama
# RUN_MODEL=<provider-specific model name>
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Paths (relative paths resolve from the current working directory)
DB_PATH=./data/csi_hierarchy.db
CACHE_DIR=./.cache
OUTPUT_XLSX=./CSI_Company_Hierarchy.xlsx
LOG_DIR=./logs
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
